generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

enum PresenceStatus {
  ONLINE
  AWAY
  IN_CALL
  OFFLINE
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum ConversationType {
  DM
  GROUP
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  AUDIO
  SYSTEM
}

enum MediaAttachmentStatus {
  PENDING
  READY
  FAILED
}

enum NotificationType {
  NEW_MESSAGE
  GROUP_INVITE
  MENTION
  SYSTEM
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  username        String         @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  isActive        Boolean        @default(true)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile         Profile?
  settings        UserSettings?
  sessions        Session[]

  // Phase 2 Relations
  memberships     ConversationMember[]
  messages        Message[]
  reactions       MessageReaction[]

  // Phase 3 Relations (E2EE Devices)
  devices         Device[]

  // Phase 4 Relations (Media & Notifications)
  mediaUploads        MediaAttachment[] @relation("UserMediaUploads")
  notifications       Notification[]    @relation("UserNotifications")
  actorNotifications  Notification[]    @relation("ActorNotifications")

  // Phase 5 Relations (Communities & Channels)
  ownedCommunities    Community[]       @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  channelMessages     ChannelMessage[]  @relation("UserChannelMessages")
  createdInvites      CommunityInvite[] @relation("UserCreatedInvites")

  @@index([email])
  @@index([username])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.VarChar(280)
  avatarUrl   String?
  bannerUrl   String?
  location    String?  @db.VarChar(100)
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model UserSettings {
  id                  String            @id @default(cuid())
  userId              String            @unique
  theme               ThemePreference   @default(DARK)
  profileVisibility   ProfileVisibility @default(PUBLIC)
  showOnlineStatus    Boolean           @default(true)
  showReadReceipts    Boolean           @default(true)
  allowDirectMessages Boolean           @default(true)
  notifyNewMessages   Boolean           @default(true)
  notifyMentions      Boolean           @default(true)
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id            String             @id @default(cuid())
  type          ConversationType
  name          String?
  avatarUrl     String?
  dmKey         String?            @unique
  isEncrypted   Boolean            @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
  @@index([dmKey])
}

model ConversationMember {
  id                 String             @id @default(cuid())
  conversationId     String
  userId             String
  role               ConversationRole   @default(MEMBER)
  lastReadMessageId  String?
  lastReadAt         DateTime?
  isMuted            Boolean            @default(false)
  isArchived         Boolean            @default(false)
  joinedAt           DateTime           @default(now())

  conversation       Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts           MessageReceipt[]

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id               String            @id @default(cuid())
  conversationId   String
  senderId         String
  clientMessageId  String
  content          String
  type              MessageType       @default(TEXT)
  isEncrypted       Boolean           @default(false)
  encryptionVersion Int?              // 1 for Phase 3 E2EE
  senderDeviceId    String?
  e2eeHeader        Json?             // Ephemeral pubkey, IV, per-device wrapped keys
  replyToId         String?
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())

  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderDevice      Device?           @relation("DeviceSentMessages", fields: [senderDeviceId], references: [id], onDelete: SetNull)
  replyTo           Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]         @relation("MessageReplies")
  reactions         MessageReaction[]
  receipts          MessageReceipt[]
  attachments       MediaAttachment[] @relation("MessageAttachments")

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([senderDeviceId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model MessageReceipt {
  id          String             @id @default(cuid())
  messageId   String
  memberId    String
  deliveredAt DateTime?
  readAt      DateTime?

  message     Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member      ConversationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId])
  @@index([messageId])
  @@index([memberId])
}

model Device {
  id                    String            @id @default(cuid())
  userId                String
  deviceName            String
  identityKeyPublic     String            // ECDH P-256 JWK string
  signingKeyPublic      String            // ECDSA P-256 JWK string
  signedPreKeyPublic    String            // ECDH P-256 JWK string
  signedPreKeySignature String            // Base64 ECDSA signature over signedPreKeyPublic
  lastActiveAt          DateTime          @default(now())
  revokedAt             DateTime?
  createdAt             DateTime          @default(now())

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneTimePreKeys        OneTimePreKey[]
  sentMessages          Message[]         @relation("DeviceSentMessages")

  @@index([userId])
  @@index([userId, revokedAt])
}

model OneTimePreKey {
  id         String    @id @default(cuid())
  deviceId   String
  keyId      Int
  publicKey  String    // ECDH P-256 JWK string
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId, consumedAt])
}

model MediaAttachment {
  id               String                @id @default(cuid())
  uploaderId       String
  messageId        String?
  channelMessageId String?
  storageKey       String                @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  durationSec      Float?
  width            Int?
  height           Int?
  status           MediaAttachmentStatus @default(PENDING)
  createdAt        DateTime              @default(now())

  uploader         User                  @relation("UserMediaUploads", fields: [uploaderId], references: [id], onDelete: Cascade)
  message          Message?              @relation("MessageAttachments", fields: [messageId], references: [id], onDelete: Cascade)
  channelMessage   ChannelMessage?       @relation("ChannelMessageAttachments", fields: [channelMessageId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([messageId])
  @@index([channelMessageId])
  @@index([status])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String           // Recipient
  actorId        String?          // Actor who triggered the notification
  type           NotificationType
  conversationId String?
  messageId      String?
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user           User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// ==========================================
// Phase 5 Models: Communities, Channels & Invites
// ==========================================

model Community {
  id          String            @id @default(cuid())
  name        String            @db.VarChar(100)
  slug        String            @unique @db.VarChar(120)
  description String?           @db.VarChar(500)
  iconUrl     String?
  bannerUrl   String?
  isPublic    Boolean           @default(true)
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     CommunityMember[]
  channels    Channel[]
  invites     CommunityInvite[]

  @@index([isPublic, createdAt])
  @@index([ownerId])
}

model CommunityMember {
  id          String        @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId, role])
}

model Channel {
  id          String        @id @default(cuid())
  communityId String
  name        String        @db.VarChar(50)
  topic       String?       @db.VarChar(255)
  type        ChannelType   @default(TEXT)
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages    ChannelMessage[]

  @@unique([communityId, name])
  @@index([communityId, position])
}

model ChannelMessage {
  id              String            @id @default(cuid())
  channelId       String
  senderId        String
  clientMessageId String
  content         String            @db.Text
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())

  channel         Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User              @relation("UserChannelMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         ChannelMessage?   @relation("ChannelMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChannelMessage[]  @relation("ChannelMessageReplies")
  attachments     MediaAttachment[] @relation("ChannelMessageAttachments")

  @@unique([senderId, clientMessageId])
  @@index([channelId, createdAt])
  @@index([channelId, deletedAt])
}

model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  creatorId   String
  code        String    @unique @db.VarChar(16)
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator     User      @relation("UserCreatedInvites", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([code])
}
