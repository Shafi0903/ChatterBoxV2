# syntax=docker/dockerfile:1
# Multi-stage production build for Chatterbox Web (Next.js Standalone)
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@12.23.0 --activate

# Copy workspace configurations
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source trees
COPY packages/shared/ ./packages/shared/
COPY apps/web/ ./apps/web/

# Build shared package
RUN pnpm --filter @chatterbox/shared build

# Build Next.js application with standalone output
RUN pnpm --filter web build

# Stage 2: Minimal Production Runner
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 chatterbox && \
    adduser --system --uid 1001 nextjs

# Copy Next.js standalone build output & static files
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:chatterbox /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:chatterbox /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
