# ==========================================
# ChatterBox Environment Configuration Template
# ==========================================

# Core Server Settings
NODE_ENV=production
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=true
THROTTLE_DISABLED=false

# PostgreSQL Configuration
POSTGRES_USER=chatterbox
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=chatterbox_prod
DATABASE_URL="postgresql://chatterbox:replace_with_strong_random_db_password@localhost:5432/chatterbox_prod?schema=public"

# Redis Cache & Presence (With requirepass auth)
REDIS_PASSWORD=replace_with_strong_random_redis_password
REDIS_URL="redis://:replace_with_strong_random_redis_password@localhost:6379"

# JWT Authentication (Secrets MUST be at least 32 characters long)
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-long-secure-access-jwt-secret-string"
JWT_REFRESH_SECRET="replace-with-at-least-32-chars-long-secure-refresh-jwt-secret-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# S3-Compatible Object Storage (RustFS / MinIO / AWS S3 / Cloudflare R2)
S3_ENDPOINT="http://localhost:9000"
# Optional browser-reachable S3 endpoint if different from internal S3_ENDPOINT
# S3_PUBLIC_ENDPOINT="https://media.example.com"
# Optional public API origin used when proxying media URLs in production
# API_PUBLIC_URL="https://api.example.com"
S3_BUCKET="chatterbox-media"
S3_ACCESS_KEY="replace_with_s3_access_key"
S3_SECRET_KEY="replace_with_s3_secret_key"

# WebRTC STUN/TURN Configuration (Optional defaults to Google STUN)
STUN_URLS="stun:stun.l.google.com:19302"
# TURN_URL="turn:turn.example.com:3478"
# TURN_USERNAME="chatterbox_turn"
# TURN_CREDENTIAL="replace_with_turn_secret"

# Frontend Public Variables
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
